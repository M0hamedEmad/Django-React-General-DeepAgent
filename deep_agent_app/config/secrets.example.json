{
  "llm": {
    "_comment": "OpenAI-compatible endpoints default to model_provider=openai. Native integrations must set model_provider explicitly.",
    "providers": {
      "openai": {
        "label": "OpenAI",
        "model_provider": "openai",
        "model": "gpt-5-mini",
        "api_key": "YOUR_OPENAI_KEY",
        "temperature": 0,
        "timeout": 120,
        "thinking": true
      },
      "ollama": {
        "label": "Ollama Cloud",
        "model": "openai/gemma4:cloud",
        "base_url": "https://ollama.com/v1",
        "api_key": "YOUR_OLLAMA_CLOUD_KEY",
        "temperature": 0,
        "timeout": 120,
        "thinking": true
      },
      "openrouter": {
        "label": "OpenRouter",
        "model": "openai/google/gemma-4-26b-a4b-it:free",
        "base_url": "https://openrouter.ai/api/v1",
        "api_key": "YOUR_OPENROUTER_KEY",
        "temperature": 0,
        "timeout": 120,
        "thinking": true
      },
      "gemini": {
        "label": "Gemini",
        "model_provider": "google_genai",
        "model": "gemini-2.5-flash",
        "api_key": "YOUR_GOOGLE_AI_KEY",
        "temperature": 0,
        "timeout": 120
      },
      "groq": {
        "label": "Groq",
        "model": "openai/gpt-oss-120b",
        "base_url": "https://api.groq.com/openai/v1",
        "api_key": "YOUR_GROQ_KEY",
        "temperature": 0,
        "timeout": 120,
        "thinking": {
          "reasoning_effort": "medium",
          "extra_body": {
            "include_reasoning": true
          }
        }
      }
    }
  },
  "tools": {
    "tavily_api_key": "YOUR_TAVILY_KEY"
  },
  "runtime": {
    "max_concurrent_runs": 4,
    "run_timeout_seconds": 1800,
    "max_model_calls_per_turn": 64,
    "max_tool_calls_per_turn": 128,
    "context_compaction": {
      "enabled": false,
      "trigger_tokens": 12000,
      "keep_messages": 8,
      "reserve_tokens": 4000
    },
    "event_buffer_size": 256,
    "sse_heartbeat_seconds": 15
  },
  "deep_agent": {
    "flash_model": "ollama",
    "main_model": "ollama",
    "frontier_model": "ollama",
    "sandbox": "bubblewrap",
    "checkpoint_db": "chat_checkpoints.sqlite",
    "mcp_servers": {
      "company": {
        "enabled": false,
        "credential_scope": "service",
        "transport": "http",
        "url": "http://localhost:8001/mcp",
        "token": "YOUR_MCP_TOKEN",
        "timeout": 60,
        "sse_read_timeout": 3600
      }
    }
  }
}
