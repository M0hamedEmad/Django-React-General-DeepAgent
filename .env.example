DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=assistant.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://assistant.example.com
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=deep_agent
DJANGO_DB_USER=deep_agent
DJANGO_DB_PASSWORD=replace-me
DJANGO_DB_HOST=postgres
DJANGO_DB_PORT=5432
DJANGO_DB_CONN_MAX_AGE=60
DEEP_AGENT_SECRETS_FILE=/run/secrets/deep-agent.json
DEEP_AGENT_LOG_LEVEL=INFO
